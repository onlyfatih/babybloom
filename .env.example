# Copy to .env.local (git-ignored). Every EXPO_PUBLIC_* value is embedded in
# the app bundle and is visible to anyone with the app: public values only.
#
# NEVER put the Supabase secret key (sb_secret_...) or the legacy
# service_role key here. The app refuses to start with one.

# demo | development | production
EXPO_PUBLIC_APP_ENV=development
# demo | supabase   (production requires supabase)
EXPO_PUBLIC_BACKEND=supabase
# development | preview | production
EXPO_PUBLIC_BUILD_VARIANT=development

# Local stack: `npx supabase start --workdir backend` prints these.
# On a phone, use your computer's LAN IP instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
